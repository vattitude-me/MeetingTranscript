<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <!-- Glanceable block: everything here must be readable from across a desk. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <View
            android:id="@+id/recDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/rec_dot" />

        <TextView
            android:id="@+id/recLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="RECORDING"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:alpha="0.7" />
    </LinearLayout>

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="00:00:00"
        android:textSize="44sp"
        android:fontFamily="monospace" />

    <me.vattitude.scribe.ui.LevelMeterView
        android:id="@+id/meter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/levelHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:alpha="0.7" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#22000000" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/livePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/liveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="Stop recording"
        android:textSize="17sp"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
