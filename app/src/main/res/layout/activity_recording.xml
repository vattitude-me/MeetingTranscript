<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/s_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp">

        <ImageButton
            android:id="@+id/collapse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/minimise"
            app:tint="@color/s_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/recording"
            android:textColor="@color/s_text_dim"
            android:textSize="15sp"
            android:fontFamily="@font/serif_regular" />
    </LinearLayout>

    <!-- Status chip: magenta means the mic is live, amber means it hears nothing. -->
    <LinearLayout
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/chip_mic">

        <View
            android:id="@+id/micDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/mic_dot" />

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_warning"
            android:contentDescription="@null"
            app:tint="@color/s_on_warn_container"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mic_live"
            android:textColor="@color/s_on_mic_container"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/serif_semibold" />
    </LinearLayout>

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="8dp"
        android:text="00:00"
        android:textColor="@color/s_text"
        android:textSize="56sp"
        android:fontFamily="@font/serif_regular"
        android:fontFeatureSettings="tnum" />

    <TextView
        android:id="@+id/recMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/s_text_muted"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.35"
        android:fontFamily="@font/serif_regular" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/surface_meter">

        <me.vattitude.scribe.ui.LevelMeterView
            android:id="@+id/meter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/levelHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/s_text_faint"
            android:textSize="12sp"
            android:fontFamily="@font/serif_regular" />

        <TextView
            android:id="@+id/micSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/builtin_mic"
            android:textColor="@color/s_text_faint"
            android:textSize="12sp"
            android:fontFamily="@font/serif_regular" />
    </LinearLayout>

    <!-- Swaps to the amber silence diagnosis when nothing is heard for 45s. -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/surface_card"
        android:padding="18dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:id="@+id/infoIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="@null"
            app:tint="@color/s_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_it"
                android:textColor="@color/s_text"
                android:textSize="15sp"
                android:fontFamily="@font/serif_semibold" />

            <TextView
                android:id="@+id/infoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/lock_it_body"
                android:textColor="@color/s_text_muted"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4"
                android:fontFamily="@font/serif_regular" />

            <!-- Only on the silence warning. Hides it until the mic hears
                 something again, for a room that is quiet on purpose. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/infoDismiss"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/dismiss"
                android:textColor="@color/s_warn"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- The rough live transcript. It is proof the mic is hearing words, not
         just noise; the accurate transcript is made after stop. -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:background="@drawable/surface_card">

        <TextView
            android:id="@+id/liveLabel"
            style="@style/TextRole.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_label" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/liveScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <TextView
                android:id="@+id/liveText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="14dp"
                android:text="@string/live_waiting"
                android:textColor="@color/s_text_faint"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.35"
                android:fontFamily="@font/serif_regular" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/stop"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/stop_button"
            android:src="@drawable/ic_stop"
            android:scaleType="centerInside"
            android:contentDescription="@string/stop_recording"
            app:tint="@color/s_on_mic" />

        <!-- Beside stop, not level with it. Stop stays the one big unmissable
             target you can hit from across a desk; pause is deliberate and
             occasional, so it is smaller and off to the side rather than
             competing for the same glance. -->
        <ImageButton
            android:id="@+id/pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pause"
            android:scaleType="centerInside"
            android:contentDescription="@string/pause_recording"
            app:tint="@color/s_text_muted" />

        <!-- Mirrors pause on the other side. Flags this moment so it is easy
             to find in the transcript later. -->
        <ImageButton
            android:id="@+id/mark"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bookmark"
            android:scaleType="centerInside"
            android:contentDescription="@string/mark_moment"
            app:tint="@color/s_cyan" />

        <TextView
            android:id="@+id/markCount"
            style="@style/TextRole.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:textColor="@color/s_cyan"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
