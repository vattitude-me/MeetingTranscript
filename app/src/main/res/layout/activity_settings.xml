<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/s_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/s_surface_1">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="@color/s_text_dim"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="18dp"
            android:text="@string/settings"
            android:textColor="@color/s_text"
            android:textSize="28sp"
            android:fontFamily="@font/serif_semibold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Your data ─────────────────────────────────────────── -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/exportRow"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_download" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/export_backup" />
                        <TextView
                            android:id="@+id/exportSub"
                            style="@style/SettingsRowSub"
                            android:text="@string/export_backup_sub" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/importRow"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_upload" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/import_backup" />
                        <TextView style="@style/SettingsRowSub" android:text="@string/import_backup_sub" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Speakers ──────────────────────────────────────────── -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_speakers" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/speakerRow"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_people" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/speaker_models" />
                        <TextView
                            android:id="@+id/speakerSub"
                            style="@style/SettingsRowSub"
                            android:text="@string/speaker_models_sub" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Storage and privacy ───────────────────────────────── -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_storage" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/retentionRow"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_shield" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/delete_audio" />
                        <TextView style="@style/SettingsRowSub" android:text="@string/delete_audio_sub" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/retentionSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/audioRow"
                    style="@style/SettingsRow">

                    <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_waveform" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="@string/clear_audio" />
                        <TextView
                            android:id="@+id/audioSub"
                            style="@style/SettingsRowSub"
                            android:text="@string/clear_audio_sub" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/clearRow"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/s_error" />

                    <LinearLayout style="@style/SettingsRowText">
                        <TextView
                            style="@style/SettingsRowTitle"
                            android:textColor="@color/s_error"
                            android:text="@string/clear_all" />
                        <TextView style="@style/SettingsRowSub" android:text="@string/clear_all_sub" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── About ─────────────────────────────────────────────── -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_waveform"
                        android:contentDescription="@null"
                        app:tint="@color/s_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/app_name"
                        android:textColor="@color/s_text"
                        android:textSize="20sp"
                        android:fontFamily="@font/serif_semibold" />
                </LinearLayout>

                <!-- Version is the first thing to ask for in a bug report, so it is
                     plain, selectable text rather than something to hunt for. -->
                <TextView
                    android:id="@+id/version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:textColor="@color/s_text_dim"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/aboutBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:text="@string/about_body"
                    android:textColor="@color/s_text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="@font/serif_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:text="@string/about_privacy"
                android:textColor="@color/s_text_faint"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/serif_regular" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
