<?xml version="1.0" encoding="utf-8"?>
<!-- A speaker header, shown only when the voice changes, over the line itself.
     Repeating the name on every line would bury the words under labels. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- A pill with a 44dp touch height: it opens the naming dialog, and the
         old bare 12sp label was a hard target to hit. -->
    <TextView
        android:id="@+id/speaker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:visibility="gone"
        android:background="@drawable/pill_speaker"
        android:foreground="?attr/selectableItemBackground" />

    <!-- Tapping a line opens Copy / Share / Play from here. -->
    <LinearLayout
        android:id="@+id/lineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/time"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:textColor="@color/s_cyan"
            android:textSize="12sp"
            android:fontFamily="@font/serif_regular"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:textColor="@color/s_text_transcript"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.62"
            android:fontFamily="@font/serif_regular" />
    </LinearLayout>
</LinearLayout>
