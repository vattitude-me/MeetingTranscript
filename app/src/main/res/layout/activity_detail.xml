<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/s_bg"
    android:fitsSystemWindows="true">

    <!-- Header sits on a raised surface so the transcript below reads as the page. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/s_surface_1">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="@color/s_text_dim"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/s_text"
                android:textSize="28sp"
                android:lineSpacingMultiplier="1.15"
                android:fontFamily="@font/serif_semibold" />

            <ImageButton
                android:id="@+id/rename"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pencil"
                android:contentDescription="@string/rename"
                app:tint="@color/s_cyan" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:textColor="@color/s_text_muted"
            android:textSize="13sp"
            android:fontFamily="@font/serif_regular" />

        <!-- Where the meeting is up to when it is not simply done, with the one
             thing you can do about it. Replaces tapping the row in the list,
             which used to start a transcription as a side effect of opening. -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:background="@drawable/surface_card"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/bannerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@null"
                    app:tint="@color/s_cyan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/bannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/s_text"
                        android:textSize="15sp"
                        android:fontFamily="@font/serif_semibold" />

                    <TextView
                        android:id="@+id/bannerBody"
                        style="@style/TextRole.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bannerProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                app:trackColor="@color/s_divider"
                app:indicatorColor="@color/s_cyan"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bannerAction"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Find in transcript. Opened from the toolbar, or already open with the
         list's search term when a search result was tapped. -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:background="@color/s_surface_2"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:tint="@color/s_text_dim" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="@string/find_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textColor="@color/s_text"
            android:textColorHint="@color/s_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/s_text_muted"
            android:textSize="13sp"
            android:fontFeatureSettings="tnum" />

        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="@string/previous_match"
            app:tint="@color/s_text_dim" />

        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/next_match"
            app:tint="@color/s_text_dim" />

        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            app:tint="@color/s_text_dim" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="30dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:textColor="@color/s_text_muted"
            android:textSize="15sp"
            android:fontFamily="@font/serif_regular"
            android:text="@string/no_transcript" />
    </FrameLayout>

    <!-- Mini player for Play from here. -->
    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="6dp"
        android:background="@color/s_surface_3"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_play"
            android:contentDescription="@null"
            app:tint="@color/s_cyan" />

        <TextView
            android:id="@+id/playerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/s_text"
            android:textSize="14sp"
            android:fontFeatureSettings="tnum" />

        <ImageButton
            android:id="@+id/playerStop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_stop"
            android:contentDescription="@string/stop_playback"
            app:tint="@color/s_text" />
    </LinearLayout>
</LinearLayout>
